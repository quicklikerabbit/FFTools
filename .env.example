# Copy this file to .env and fill it in. .env is gitignored, so your IDs stay local.

# Your Sleeper user_id (a long number, not your username). Look it up at:
#   https://api.sleeper.app/v1/user/<yourUsername>
SLEEPER_USER_ID=

# Your leagues as comma-separated name:leagueId pairs. Use the names on the
# command line (e.g. `npm run roster -- work`). The first league is the default
# when you don't pass one.
#
# A league's ID is in its URL (https://sleeper.com/leagues/<leagueId>/...), or
# list all of yours for a season at:
#   https://api.sleeper.app/v1/user/<yourUserId>/leagues/nfl/<season>
#
# Example: SLEEPER_LEAGUES=home:123456789012345678,work:876543210987654321
SLEEPER_LEAGUES=
